<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy" content="
    default-src 'self';
    script-src  'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net https://*.i.posthog.com;
    style-src   'self' 'unsafe-inline' https://fonts.googleapis.com;
    font-src    'self' https://fonts.gstatic.com;
    img-src     'self' data: blob: https://tzwjxgprhorqrmpqudgg.supabase.co;
    connect-src 'self' https://tzwjxgprhorqrmpqudgg.supabase.co wss://tzwjxgprhorqrmpqudgg.supabase.co https://*.i.posthog.com;
    object-src  'none';
    base-uri    'self';
    form-action 'self';
    upgrade-insecure-requests;
    block-all-mixed-content;
  ">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>Proposta O&amp;M — Ágil Solar</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://unpkg.com/posthog-js@1.364.2/dist/array.js"></script>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="assets/img/icon.png">
  <link rel="manifest" href="manifest.webmanifest">
  <meta name="theme-color" content="#050505">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Agil Solar O&M">
  <link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
        }
      }
    }
  </script>
  <link rel="stylesheet" href="assets/css/main.css">
  <style>
    .om-hero-bg {
      background:
        radial-gradient(900px 380px at 85% -10%, rgba(59,130,246,.22), transparent 60%),
        radial-gradient(700px 360px at 0% 110%, rgba(6,182,212,.10), transparent 60%),
        linear-gradient(180deg, #0c0c0c 0%, #0a0a0a 100%);
    }
    .om-hero-grid {
      background-image:
        linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
      background-size: 40px 40px;
    }
    .om-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.08), transparent);
    }
    .om-price-bg {
      background:
        radial-gradient(500px 220px at 50% 0%, rgba(59,130,246,.22), transparent 60%),
        linear-gradient(180deg, rgba(30,58,138,.35) 0%, #0a0a0a 100%);
    }
    .om-cta-shadow { box-shadow: 0 14px 40px -12px rgba(59,130,246,0.55); }
    .om-benefit-card {
      background: linear-gradient(180deg, rgba(23,23,23,.6) 0%, rgba(10,10,10,.4) 100%);
    }
    .om-benefit-card:hover { border-color: rgba(59,130,246,.4); }
    @keyframes om-pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%      { opacity: .5; transform: scale(.85); }
    }
    .om-pulse { animation: om-pulse-dot 2s ease-in-out infinite; }

    /* Steps "Como funciona" */
    .om-step {
      background: linear-gradient(180deg, rgba(23,23,23,.4) 0%, rgba(10,10,10,.2) 100%);
      transition: background .25s ease, border-color .25s ease;
    }
    .om-step:hover {
      background: linear-gradient(180deg, rgba(59,130,246,.06) 0%, rgba(10,10,10,.2) 100%);
    }

    @media (prefers-reduced-motion: reduce) {
      .om-pulse { animation: none; }
    }
  </style>
</head>
<body class="selection:bg-blue-500 selection:text-black min-h-screen flex flex-col items-center bg-[#050505] font-sans text-neutral-200">

<!-- Loading -->
<div id="loading" class="fixed inset-0 z-50 bg-[#050505] flex flex-col items-center justify-center">
  <i data-lucide="loader" class="w-10 h-10 text-blue-400 animate-spin mb-4"></i>
  <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">Carregando proposta...</p>
</div>

<!-- Erro -->
<div id="error-state" class="hidden flex-col items-center justify-center min-h-screen p-4 text-center">
  <i data-lucide="file-warning" class="w-16 h-16 text-red-500 mb-4"></i>
  <h1 class="text-2xl font-black text-white uppercase mb-2">Proposta indisponível</h1>
  <p class="text-neutral-500 max-w-md">Este link é inválido ou a proposta expirou. Entre em contato com a Ágil Solar.</p>
</div>

<!-- Conteúdo -->
<main id="proposal-content" class="hidden w-full max-w-3xl px-4 py-6 md:py-10 flex flex-col gap-4">

  <!-- 1) HERO -->
  <section class="om-hero-bg relative border border-neutral-800 overflow-hidden">
    <div class="om-hero-grid absolute inset-0 opacity-40 pointer-events-none"></div>

    <div class="relative p-6 md:p-8">
      <!-- Top row: logo + status -->
      <div class="flex items-center justify-between gap-3 mb-8">
        <img src="assets/img/logo.png" alt="Ágil Solar" class="h-7 md:h-8 w-auto" onerror="this.style.display='none'">
        <span id="status-chip" class="inline-flex items-center gap-1.5 px-2.5 py-1 border text-[10px] font-black uppercase tracking-widest bg-blue-500/10 text-blue-300 border-blue-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-current om-pulse"></span><span id="status-label">—</span>
        </span>
      </div>

      <!-- Service title -->
      <div class="text-[10px] font-black uppercase tracking-[0.22em] text-blue-400/90 mb-3 inline-flex items-center gap-2">
        <span class="w-6 h-px bg-blue-400/60"></span> Proposta de serviço
      </div>
      <h1 id="hero-service-title" class="text-3xl md:text-5xl font-black text-white tracking-tight leading-[1.05]">—</h1>

      <!-- Cliente row -->
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <span class="inline-flex items-center gap-1.5 text-neutral-300">
          <i data-lucide="user" class="w-3.5 h-3.5 text-blue-400"></i>
          <span id="client-name" class="text-white font-bold">—</span>
        </span>
        <span class="inline-flex items-center gap-1.5 text-neutral-400">
          <i data-lucide="map-pin" class="w-3.5 h-3.5 text-neutral-500"></i>
          <span id="client-address">—</span>
        </span>
      </div>

      <!-- Meta strip integrada ao hero -->
      <div class="mt-7 pt-5 border-t border-neutral-800/80 flex flex-wrap items-center gap-x-6 gap-y-2 text-[11px] uppercase tracking-widest font-bold text-neutral-500">
        <span><span id="proposal-number" class="text-neutral-300">—</span></span>
        <span class="text-neutral-700">·</span>
        <span>Válida até <span id="validade" class="text-neutral-300">—</span></span>
      </div>
    </div>
  </section>

  <!-- 2) FICHA RÁPIDA (4 cards grandes c/ ícone) -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-2.5">
    <div class="bg-neutral-900/40 border border-neutral-800 p-4 flex flex-col gap-2">
      <div class="w-8 h-8 bg-blue-500/10 text-blue-400 grid place-items-center"><i data-lucide="wrench" class="w-4 h-4"></i></div>
      <div>
        <div class="text-[9px] font-black uppercase tracking-widest text-neutral-500 mb-0.5">Serviço</div>
        <div id="sum-service" class="text-[13px] font-bold text-white leading-tight">—</div>
      </div>
    </div>
    <div class="bg-neutral-900/40 border border-neutral-800 p-4 flex flex-col gap-2">
      <div class="w-8 h-8 bg-blue-500/10 text-blue-400 grid place-items-center"><i data-lucide="map-pin" class="w-4 h-4"></i></div>
      <div>
        <div class="text-[9px] font-black uppercase tracking-widest text-neutral-500 mb-0.5">Local</div>
        <div id="sum-system" class="text-[13px] font-bold text-white leading-tight">—</div>
      </div>
    </div>
    <div class="bg-neutral-900/40 border border-neutral-800 p-4 flex flex-col gap-2">
      <div class="w-8 h-8 bg-blue-500/10 text-blue-400 grid place-items-center"><i data-lucide="calendar-clock" class="w-4 h-4"></i></div>
      <div>
        <div class="text-[9px] font-black uppercase tracking-widest text-neutral-500 mb-0.5">Prazo</div>
        <div class="text-[13px] font-bold text-white leading-tight">Até 5 dias úteis</div>
      </div>
    </div>
    <div class="bg-blue-500/[0.08] border border-blue-500/25 p-4 flex flex-col gap-2">
      <div class="w-8 h-8 bg-blue-500/20 text-blue-300 grid place-items-center"><i data-lucide="badge-dollar-sign" class="w-4 h-4"></i></div>
      <div>
        <div class="text-[9px] font-black uppercase tracking-widest text-blue-300/80 mb-0.5">Investimento</div>
        <div id="sum-investment" class="text-[14px] font-black text-blue-300 leading-tight">—</div>
      </div>
    </div>
  </section>

  <!-- 3) BENEFÍCIOS (substitui o textão "por que realizar") -->
  <section>
    <div class="flex items-center gap-2 mb-3">
      <span class="w-4 h-px bg-blue-400/60"></span>
      <div class="text-[10px] font-black uppercase tracking-[0.22em] text-blue-400/90">Por que vale a pena</div>
    </div>
    <div class="grid grid-cols-3 gap-2.5">
      <div class="om-benefit-card border border-neutral-800 p-4 md:p-5 transition-colors">
        <i data-lucide="trending-up" class="w-5 h-5 text-blue-400 mb-3"></i>
        <div class="text-2xl md:text-3xl font-black text-white leading-none">+8%</div>
        <div class="text-[11px] text-neutral-400 mt-1.5 leading-snug">de geração após limpeza</div>
      </div>
      <div class="om-benefit-card border border-neutral-800 p-4 md:p-5 transition-colors">
        <i data-lucide="shield-alert" class="w-5 h-5 text-blue-400 mb-3"></i>
        <div class="text-2xl md:text-3xl font-black text-white leading-none">100%</div>
        <div class="text-[11px] text-neutral-400 mt-1.5 leading-snug">inspeção visual de segurança</div>
      </div>
      <div class="om-benefit-card border border-neutral-800 p-4 md:p-5 transition-colors">
        <i data-lucide="battery-charging" class="w-5 h-5 text-blue-400 mb-3"></i>
        <div class="text-2xl md:text-3xl font-black text-white leading-none">+25a</div>
        <div class="text-[11px] text-neutral-400 mt-1.5 leading-snug">de vida útil preservada</div>
      </div>
    </div>
  </section>

  <!-- 4) ESCOPO (visual: split com headers fortes) -->
  <section class="grid grid-cols-1 md:grid-cols-5 gap-2.5">
    <!-- Incluso -->
    <div class="md:col-span-3 bg-gradient-to-br from-blue-500/[0.10] via-neutral-900/40 to-transparent border border-blue-500/30 overflow-hidden">
      <div class="px-5 py-3 bg-blue-500/[0.08] border-b border-blue-500/20 flex items-center justify-between">
        <div class="inline-flex items-center gap-2">
          <i data-lucide="check-circle-2" class="w-4 h-4 text-blue-300"></i>
          <span class="text-[11px] font-black uppercase tracking-[0.18em] text-blue-300">Incluso no serviço</span>
        </div>
      </div>
      <div class="p-5">
        <ul id="incluso-list" class="space-y-2.5 text-sm text-neutral-100"></ul>
        <p id="service-desc" class="hidden mt-4 pt-4 border-t border-blue-500/15 text-[13px] text-neutral-300 whitespace-pre-line"></p>
      </div>
    </div>

    <!-- Fora -->
    <div class="md:col-span-2 bg-neutral-900/40 border border-neutral-800 overflow-hidden">
      <div class="px-5 py-3 bg-neutral-900 border-b border-neutral-800 flex items-center gap-2">
        <i data-lucide="minus-circle" class="w-3.5 h-3.5 text-neutral-500"></i>
        <span class="text-[11px] font-black uppercase tracking-[0.18em] text-neutral-500">Fora do escopo</span>
      </div>
      <div class="p-5">
        <ul id="nao-incluso-list" class="space-y-2 text-[12.5px] text-neutral-400"></ul>
      </div>
    </div>
  </section>

  <!-- 4.5) DADOS DO SISTEMA DO CLIENTE -->
  <section class="bg-neutral-900/40 border border-neutral-800 overflow-hidden">
    <div class="px-5 py-3 border-b border-neutral-800/80 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <i data-lucide="sun" class="w-3.5 h-3.5 text-blue-400"></i>
        <span class="text-[11px] font-black uppercase tracking-[0.18em] text-blue-300">Dados do sistema</span>
      </div>
      <span class="text-[10px] uppercase tracking-widest font-bold text-neutral-500 hidden sm:inline">Sistema fotovoltaico do cliente</span>
    </div>

    <!-- Estado preenchido (4 cards) -->
    <div id="sys-cards" class="grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 divide-neutral-800/80">
      <div class="p-4">
        <div class="flex items-center gap-2 text-[9px] font-black uppercase tracking-widest text-neutral-500 mb-2"><i data-lucide="zap" class="w-3 h-3"></i>Potência</div>
        <div id="sys-potencia" class="text-[13px] font-bold text-white leading-tight">—</div>
      </div>
      <div class="p-4">
        <div class="flex items-center gap-2 text-[9px] font-black uppercase tracking-widest text-neutral-500 mb-2"><i data-lucide="grid-3x3" class="w-3 h-3"></i>Módulos</div>
        <div id="sys-modulos" class="text-[13px] font-bold text-white leading-tight">—</div>
      </div>
      <div class="p-4">
        <div class="flex items-center gap-2 text-[9px] font-black uppercase tracking-widest text-neutral-500 mb-2"><i data-lucide="cpu" class="w-3 h-3"></i>Inversor</div>
        <div id="sys-inversor" class="text-[13px] font-bold text-white leading-tight">—</div>
      </div>
      <div class="p-4">
        <div class="flex items-center gap-2 text-[9px] font-black uppercase tracking-widest text-neutral-500 mb-2"><i data-lucide="home" class="w-3 h-3"></i>Telhado</div>
        <div id="sys-telhado" class="text-[13px] font-bold text-white leading-tight">—</div>
      </div>
    </div>

    <!-- Estado vazio (quando nada cadastrado) -->
    <div id="sys-empty" class="hidden p-5 flex items-center gap-3">
      <i data-lucide="info" class="w-4 h-4 text-neutral-500 shrink-0"></i>
      <div class="text-[12.5px] text-neutral-400">Dados técnicos do sistema serão confirmados pela nossa equipe durante a visita.</div>
    </div>
  </section>

  <!-- 5) COMO FUNCIONA (cards expandidos) -->
  <section class="bg-neutral-900/40 border border-neutral-800 overflow-hidden">
    <div class="px-5 py-3 border-b border-neutral-800/80 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <i data-lucide="route" class="w-3.5 h-3.5 text-blue-400"></i>
        <span class="text-[11px] font-black uppercase tracking-[0.18em] text-blue-300">Como funciona</span>
      </div>
      <span class="text-[10px] uppercase tracking-widest font-bold text-neutral-500 hidden sm:inline">4 etapas · sem surpresas</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-neutral-800/80">
      <div class="om-step p-5 relative">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 bg-blue-500/15 border border-blue-500/40 text-blue-300 grid place-items-center font-black text-sm">1</div>
          <i data-lucide="check-circle-2" class="w-4 h-4 text-blue-400/70 ml-auto"></i>
        </div>
        <div class="text-[14px] font-black text-white leading-tight">Aprova</div>
        <p class="mt-1.5 text-[12px] text-neutral-400 leading-relaxed">Você confirma a proposta pelo botão abaixo.</p>
      </div>

      <div class="om-step p-5 relative">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 bg-blue-500/15 border border-blue-500/40 text-blue-300 grid place-items-center font-black text-sm">2</div>
          <i data-lucide="calendar-check" class="w-4 h-4 text-blue-400/70 ml-auto"></i>
        </div>
        <div class="text-[14px] font-black text-white leading-tight">Agendamos</div>
        <p class="mt-1.5 text-[12px] text-neutral-400 leading-relaxed">Combinamos data e horário que cabem na sua rotina.</p>
      </div>

      <div class="om-step p-5 relative">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 bg-blue-500/15 border border-blue-500/40 text-blue-300 grid place-items-center font-black text-sm">3</div>
          <i data-lucide="wrench" class="w-4 h-4 text-blue-400/70 ml-auto"></i>
        </div>
        <div class="text-[14px] font-black text-white leading-tight">Executamos</div>
        <p class="mt-1.5 text-[12px] text-neutral-400 leading-relaxed">Equipe técnica realiza o serviço no local com segurança.</p>
      </div>

      <div class="om-step p-5 relative">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 bg-blue-500/15 border border-blue-500/40 text-blue-300 grid place-items-center font-black text-sm">4</div>
          <i data-lucide="file-text" class="w-4 h-4 text-blue-400/70 ml-auto"></i>
        </div>
        <div class="text-[14px] font-black text-white leading-tight">Relatório</div>
        <p class="mt-1.5 text-[12px] text-neutral-400 leading-relaxed">Você recebe um PDF com fotos antes/depois e checklist.</p>
      </div>
    </div>
  </section>

  <!-- 7) INVESTIMENTO + CTA PRIMÁRIO -->
  <section class="om-price-bg border border-blue-500/30 relative overflow-hidden">
    <div class="p-6 md:p-8 text-center relative">
      <div class="text-[10px] font-black uppercase tracking-[0.22em] text-blue-300/90 mb-3">Investimento total</div>
      <div id="valor" class="text-5xl md:text-6xl font-black text-white tracking-tighter leading-none">—</div>

      <div class="mt-5 inline-flex flex-col md:flex-row items-center gap-2 md:gap-3 text-[12.5px] text-neutral-300">
        <span class="inline-flex items-center gap-1.5"><i data-lucide="credit-card" class="w-3.5 h-3.5 text-blue-400"></i><span id="pagamento">—</span></span>
        <span class="hidden md:inline text-neutral-700">•</span>
        <span class="inline-flex items-center gap-1.5"><i data-lucide="calendar-check" class="w-3.5 h-3.5 text-blue-400"></i>Válida até <span id="validade2" class="text-white font-bold">—</span></span>
        <span class="hidden md:inline text-neutral-700">•</span>
        <span class="inline-flex items-center gap-1.5"><i data-lucide="shield-check" class="w-3.5 h-3.5 text-blue-400"></i>90 dias de garantia</span>
      </div>

      <div class="om-divider my-7 max-w-md mx-auto"></div>

      <div id="actions-section" class="flex flex-col items-center gap-3">
        <button id="btn-aprovar" class="om-cta-shadow w-full max-w-md px-6 py-4 bg-gradient-to-b from-blue-400 to-blue-600 hover:from-blue-300 hover:to-blue-500 text-blue-950 font-black text-[13px] uppercase tracking-[0.18em] inline-flex items-center justify-center gap-2.5 transition-all">
          <i data-lucide="check" class="w-4 h-4 stroke-[3.5]"></i>Aprovar proposta
        </button>
        <a id="btn-whatsapp" href="#" target="_blank" rel="noopener" class="w-full max-w-md px-6 py-3 bg-neutral-900 border border-neutral-700 hover:border-blue-500/40 text-white font-black text-[11px] uppercase tracking-[0.16em] inline-flex items-center justify-center gap-2">
          <i data-lucide="message-circle" class="w-4 h-4"></i>Tirar dúvida no WhatsApp
        </a>
        <button id="btn-recusar" class="text-[11px] font-bold uppercase tracking-widest text-neutral-500 hover:text-red-400 inline-flex items-center gap-1.5 mt-1">
          <i data-lucide="x" class="w-3 h-3"></i>Recusar proposta
        </button>

        <div id="response-banner" class="hidden mt-3 w-full max-w-md p-3 border text-[12px] text-center"></div>
      </div>
    </div>
  </section>

  <!-- 8) FAIXA FINAL: equipe + garantia + responsável (compacta) -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-2">
    <div class="bg-neutral-900/40 border border-neutral-800 p-4 flex items-center gap-3">
      <i data-lucide="hard-hat" class="w-4 h-4 text-blue-400 shrink-0"></i>
      <div class="min-w-0">
        <div class="text-[10px] font-black uppercase tracking-widest text-neutral-500">Responsável</div>
        <div id="responsavel" class="text-[12.5px] font-bold text-white truncate">—</div>
      </div>
    </div>
    <div class="bg-neutral-900/40 border border-neutral-800 p-4 flex items-center gap-3">
      <i data-lucide="building-2" class="w-4 h-4 text-blue-400 shrink-0"></i>
      <div class="min-w-0">
        <div class="text-[10px] font-black uppercase tracking-widest text-neutral-500">Franquia</div>
        <div id="franquia" class="text-[12.5px] font-bold text-white truncate">Ágil Solar</div>
      </div>
    </div>
    <div class="bg-blue-500/[0.06] border border-blue-500/20 p-4 flex items-center gap-3">
      <i data-lucide="shield-check" class="w-4 h-4 text-blue-300 shrink-0"></i>
      <div class="min-w-0">
        <div class="text-[10px] font-black uppercase tracking-widest text-blue-300/80">Garantia</div>
        <div class="text-[12.5px] font-bold text-white">90 dias do serviço</div>
      </div>
    </div>
  </section>

  <footer class="text-center text-[11px] text-neutral-600 pt-2 pb-8">
    Ágil Solar · Operação &amp; Manutenção · Proposta exclusiva e confidencial.
  </footer>
</main>

<!-- Modal de aceite (assinatura) -->
<div id="aceite-modal" class="hidden fixed inset-0 z-[60] bg-black/80 backdrop-blur-sm items-center justify-center p-4">
  <div class="bg-[#0c0c0c] border border-neutral-800 w-full max-w-lg max-h-[94vh] overflow-y-auto">
    <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-800">
      <h2 class="text-sm font-black uppercase tracking-widest text-white">Confirmar aprovação</h2>
      <button id="aceite-fechar" type="button" class="text-neutral-500 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>

    <div class="p-5 space-y-4">
      <div>
        <div class="text-[10px] font-black uppercase tracking-[0.18em] text-blue-400/90 mb-1.5">Termo de ciência</div>
        <div id="aceite-texto" class="bg-neutral-950 border border-neutral-800 p-3 text-[12px] text-neutral-300 leading-relaxed max-h-36 overflow-y-auto"></div>
      </div>

      <div>
        <label for="aceite-nome" class="block text-[10px] font-black uppercase tracking-[0.18em] text-blue-400/90 mb-1.5">Seu nome completo</label>
        <input id="aceite-nome" type="text" autocomplete="name" placeholder="Nome de quem está aprovando"
          class="w-full bg-neutral-950 border border-neutral-800 focus:border-blue-500/60 outline-none px-3 py-2.5 text-sm text-white" />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-[10px] font-black uppercase tracking-[0.18em] text-blue-400/90">Assinatura</span>
          <button id="aceite-limpar" type="button" class="text-[10px] font-bold uppercase tracking-widest text-neutral-500 hover:text-blue-400">Limpar</button>
        </div>
        <canvas id="aceite-canvas" width="500" height="180"
          class="w-full bg-white border border-neutral-700 touch-none cursor-crosshair" style="aspect-ratio:500/180;"></canvas>
        <div class="text-[10px] text-neutral-600 mt-1">Assine no quadro acima com o dedo ou o mouse.</div>
      </div>

      <label class="flex items-start gap-2.5 cursor-pointer">
        <input id="aceite-check" type="checkbox" class="mt-0.5 w-4 h-4 accent-blue-500 shrink-0" />
        <span class="text-[12px] text-neutral-300 leading-relaxed">Li o termo de ciência acima e confirmo, de forma livre e consciente, o aceite desta proposta.</span>
      </label>

      <div id="aceite-erro" class="hidden p-3 border border-red-500/30 bg-red-500/10 text-red-300 text-[12px]"></div>
    </div>

    <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-neutral-800 bg-neutral-950/60">
      <button id="aceite-cancelar" type="button" class="px-4 py-2.5 bg-neutral-900 border border-neutral-700 text-neutral-300 font-black text-[11px] uppercase tracking-widest">Cancelar</button>
      <button id="aceite-confirmar" type="button" class="px-5 py-2.5 bg-gradient-to-b from-blue-400 to-blue-600 text-blue-950 font-black text-[11px] uppercase tracking-widest inline-flex items-center gap-2">
        <i data-lucide="check" class="w-4 h-4 stroke-[3.5]"></i>Confirmar aprovação
      </button>
    </div>
  </div>
</div>

<script src="assets/js/config.js"></script>
<script src="assets/js/analytics.js"></script>
<script src="assets/js/utils.js"></script>
<script src="assets/js/proposta-om.js"></script>
</body>
</html>
